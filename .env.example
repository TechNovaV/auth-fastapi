# ===== Server =====
APP_ENV=development

# ===== Database =====
# MySQL (mục tiêu): mysql+pymysql://<user>:<pass>@<host>:3306/<db>
# SQLite (chạy nhanh, không cần cài server): sqlite:///./auth.db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/auth_db

# ===== JWT (token kép) — đổi thành 2 chuỗi ngẫu nhiên KHÁC NHAU =====
JWT_SECRET=please_change_me_access
JWT_REFRESH_SECRET=please_change_me_refresh
ACCESS_TOKEN_EXPIRES_MIN=15
REFRESH_TOKEN_EXPIRES_DAYS=7

# ===== Bcrypt =====
BCRYPT_ROUNDS=12

# ===== CORS =====
CORS_ORIGINS=http://localhost:8000

# ===== Quên mật khẩu / Email =====
OTP_TTL_MINUTES=5
MAIL_FROM=no-reply@auth-demo.local

# ===== Đăng nhập SMS (OTP số điện thoại) =====
SMS_OTP_TTL_MINUTES=2
SMS_OTP_RESEND_SECONDS=60

# ===== Google reCAPTCHA v3 (để trống = tắt) =====
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# ===== WebAuthn (Vân tay / FaceID qua trình duyệt) =====
RP_ID=localhost
RP_NAME=Auth System
RP_ORIGIN=http://localhost:8000
