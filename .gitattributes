# Chuẩn hoá xuống dòng: repo luôn lưu LF, checkout ra LF.
# => Hết cảnh báo "LF will be replaced by CRLF" trên Windows.
* text=auto eol=lf

# Một số loại nên cố định LF rõ ràng
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.env   text eol=lf

# Tệp nhị phân: Git không đụng vào EOL
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
